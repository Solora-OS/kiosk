[Unit]
Description=Solora Local Hub Server
Documentation=https://github.com/Solora-OS/kiosk
After=network.target
Wants=network-online.target

[Service]
Type=simple

# Run as the kiosk user (replace "solora" with your actual Linux username)
User=%i
Group=%i

# Working directory — server package root
WorkingDirectory=/opt/solora/server

# Node.js binary (adjust path if using nvm or a different install location)
ExecStart=/usr/bin/node /opt/solora/server/dist/index.js

# Restart on failure with a short backoff
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Environment
Environment=NODE_ENV=production
Environment=SOLORA_PORT=4000

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.solora

# Logging — captured by journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=solora-server

[Install]
WantedBy=multi-user.target
