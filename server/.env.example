# Port the local hub Express server listens on
LUMORA_PORT=4000

# Central server (lumora_central_api + lumora_central_socket_io)
# Replace with your central server's IP or domain (NOT the local hub IP)
CENTRAL_API_URL=http://<central-server-ip>:4000
CENTRAL_SOCKET_URL=<central-server-ip>:5001

# Hub identity (used on first registration with central API)
HUB_NAME=Lumora Hub
HUB_OWNER_EMAIL=<your-admin-email>

# Supabase project credentials — obtain from Supabase dashboard → Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret-from-dashboard>

# Google OAuth credentials for server-side token exchange
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# Microsoft OAuth credentials for server-side token exchange
MICROSOFT_CLIENT_ID=<your-microsoft-oauth-client-id>
MICROSOFT_CLIENT_SECRET=<your-microsoft-oauth-client-secret>
MICROSOFT_TENANT_ID=<your-microsoft-tenant-id-or-common>

# CORS: comma-separated list of additional allowed origins (optional)
ALLOWED_ORIGINS=
