# The household hub runs inside the app on localhost:4000. Only a plain browser
# (vite dev) can use another hub:
# VITE_SOLORA_SERVER_URL=http://<hub-ip>:4000

# Google OAuth credentials — obtain from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
VITE_GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>

# Microsoft OAuth credentials — obtain from Azure App Registrations
VITE_MICROSOFT_CLIENT_ID=<your-microsoft-oauth-client-id>
VITE_MICROSOFT_CLIENT_SECRET=<your-microsoft-oauth-client-secret>
VITE_MICROSOFT_TENANT_ID=<your-microsoft-tenant-id-or-common>

# Central server (REST API + Socket.IO relay)
VITE_CENTRAL_API_URL=http://<central-server-ip>:4000
VITE_CENTRAL_SOCKET_URL=http://<central-server-ip>:5001

# Kiosk shell flags (defaults shown: kiosk mode on, sign-out hidden, no auto sign-in)
# VITE_KIOSK_MODE=true
# VITE_KIOSK_AUTO_SIGNIN=false
# VITE_KIOSK_HIDE_SIGNOUT=true

# Browser-only UI work: fake Wi-Fi network list (ignored inside Tauri)
# VITE_WIFI_MOCK=1
